{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "SupportGroupsData.schema.json",
  "title": "SupportGroupsData",
  "description": "Cancer Open Data v2. A null value or an empty list means the information is not given yet: apps should show \"Not given\".",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Path to this file's JSON Schema."
    },
    "meta": {
      "type": "object",
      "description": "About this file: what it is, when its records last changed, how many there are, and its license. Written by scripts/convert-v2.mjs.",
      "properties": {
        "title": {
          "type": "string",
          "description": "Short name of the dataset."
        },
        "description": {
          "type": "string",
          "description": "What the dataset holds."
        },
        "apiVersion": {
          "const": "v2",
          "description": "API version of this file."
        },
        "lastUpdated": {
          "type": "string",
          "format": "date",
          "description": "Date (YYYY-MM-DD, Philippine time) the records last changed. Rebuilding without changes keeps the date."
        },
        "recordCount": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of records in this file."
        },
        "coverage": {
          "type": "string",
          "description": "Area the data covers."
        },
        "language": {
          "type": "string",
          "description": "Language of the text (BCP 47 code)."
        },
        "license": {
          "const": "CC0-1.0",
          "description": "License of the data (SPDX id). Logos and photos in images/ belong to their owners."
        },
        "licenseURL": {
          "type": "string",
          "format": "uri"
        },
        "publisher": {
          "type": "string"
        },
        "contact": {
          "type": "string",
          "format": "uri",
          "description": "Where to report wrong data or ask questions."
        },
        "schema": {
          "const": "./SupportGroupsData.schema.json",
          "description": "This file's JSON Schema."
        }
      },
      "required": [
        "title",
        "description",
        "apiVersion",
        "lastUpdated",
        "recordCount",
        "coverage",
        "language",
        "license",
        "licenseURL",
        "publisher",
        "contact",
        "schema"
      ],
      "additionalProperties": false
    },
    "supportGroup": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "General Support Groups",
              "Peer Support Groups",
              "Therapeutic Support",
              "Condition-Specific Support Groups",
              "Online Support Groups",
              "Family Support Groups",
              "Educational Support Groups"
            ]
          },
          "cancerTypes": {
            "$ref": "#/$defs/cancerTypes"
          },
          "socmedURL": {
            "type": [
              "null",
              "string"
            ],
            "format": "uri",
            "description": "Official social media page URL, or null if not known."
          },
          "bgImageURL": {
            "type": "string",
            "description": "Background image: a path in this API like /images/<Folder>/<file>.webp, or a full https:// URL.",
            "format": "uri-reference"
          },
          "location": {
            "type": "string"
          },
          "latitude": {
            "type": [
              "null",
              "number"
            ],
            "description": "Latitude (from Google Maps). null if not known."
          },
          "longitude": {
            "type": [
              "null",
              "number"
            ],
            "description": "Longitude (from Google Maps). null if not known."
          },
          "founders": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true,
            "description": "Founders' names as written. Empty if not given."
          },
          "meetingSchedule": {
            "type": [
              "null",
              "string"
            ],
            "description": "When the group meets, as written, e.g. 'Every 1st Saturday, 2:00 pm'. null if not given."
          },
          "sources": {
            "$ref": "#/$defs/sources"
          },
          "contacts": {
            "$ref": "#/$defs/contacts"
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "type",
          "cancerTypes",
          "socmedURL",
          "bgImageURL",
          "location",
          "latitude",
          "longitude",
          "founders",
          "meetingSchedule",
          "sources",
          "contacts"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "meta",
    "supportGroup"
  ],
  "additionalProperties": false,
  "$defs": {
    "contact": {
      "type": "object",
      "properties": {
        "contactID": {
          "type": "integer"
        },
        "type": {
          "type": "string",
          "enum": [
            "Hotline",
            "Landline",
            "Mobile",
            "Email",
            "Website",
            "Facebook",
            "Other"
          ],
          "description": "Kind of contact. One fixed list for all datasets."
        },
        "contactDetails": {
          "type": "string"
        }
      },
      "required": [
        "contactID",
        "type",
        "contactDetails"
      ],
      "additionalProperties": false
    },
    "contacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/contact"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      },
      "uniqueItems": true,
      "description": "Links to the pages these facts come from. Empty if no source is given (show \"Not given\")."
    },
    "cancerTypes": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true,
      "description": "Cancers this covers, e.g. ['Breast Cancer']. ['All cancers'] if it covers every cancer. null if the source doesn't say (show \"Not given\")."
    }
  }
}
