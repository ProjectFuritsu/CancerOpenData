            1
          ],
          "service_name": "Radiation Oncology Department",
          "service_description": "The oncology Center uses clinical and holistic approaches for the management of cancer. We aim to cure- to eradicate the tumor and prevent its recurrence, as well as to relieve pain and other discomforts of cancer. Equipment: Dual Energy Linear Accelerator; the Elekta Synergy linear Accelerator- the first IMRT/IGRT facility. Services Offered: Radiation Consultation Evaluation; Treatment Planning; External Beam Radiography; Low Dose Rate (LDR) Brachytherapy; Blood Irradiation. Location: Ground Level, Oncology Building. Office Hours: 6:00am - 6:00pm. Contact: (082) 222 8000 local 8158 | radonco@ddh.com.ph",
          "cancerTypes": null,
          "fee": null,
          "sources": [
            "https://ddh.com.ph/services-and-centers/radiation-oncology-department/"
          ],
          "service_schedule": null,
          "requirements": [
            {
              "requirement_id": 1,
              "requirement_description": "Referral letter and a short clinical abstract."
            },
            {
              "requirement_id": 2,
              "requirement_description": "Histopathologic report."
            },
            {
              "requirement_id": 3,
              "requirement_description": "Laboratory and Imaging work-ups with results and radiographs."
            },
            {
              "requirement_id": 4,
              "requirement_description": "Complete blood count preferably normal or least 100 grams/dl. hemoglobin"
            },
            {
              "requirement_id": 5,
              "requirement_description": "Dental clearance for head and neck tumors."
            },
            {
              "requirement_id": 6,
              "requirement_description": "Steroid coverage for brain and spinal cord irradiation."
            }
          ],
          "procedure": []
        },
        {
          "serviceID": 2,
          "branchIDs": [
            1
          ],
          "service_name": "External Beam Radiation Therapy",
          "service_description": "Curative: Destroy tumors that have not spread the other parts of the body and cure you of disease reduce the risk that cancer will return after you undergo surgery or systemic/chemotherapy by killing small amounts of remaining cancer cells shrink cancer before surgery. Palliative: Shrink tumors that are interfering with your quality of life, such as lung tumor that is causing shortness of breath to relieve pain by reducing the size of a tumor and other unpleasant symptoms, thus improving the quality of life and prolongation of survival. Radiation Therapy usually takes from a week to eight weeks, depending on the goal, either curative or palliative. It is given daily from Monday to Friday lasting only for a few minutes, based on the prescribed dose and number of treatment fields. Who can avail? It has clinical applications for patients diagnosed with malignant tumors and occasionally benign diseases. Location: Ground floor of Oncology Building. Contact: +63 82 222 8000 local 8158 | +63 82 222 7992 | radonco@ddh.com.ph",
          "cancerTypes": [
            "Brain / spinal cord tumors",
            "Head and neck tumors",
            "Lung cancer",
            "Breast cancer",
            "Cervix/ Endometrial / Ovarian",
            "Vulvar cancer",
            "Rectal cancer",
            "Lymphoma",
            "soft tissue tumors"
