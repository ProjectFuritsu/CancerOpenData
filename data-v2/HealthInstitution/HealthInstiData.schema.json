{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "HealthInstiData.schema.json",
  "title": "HealthInstiData",
  "description": "Cancer Open Data v2. A null value or an empty list means the information is not given yet: apps should show \"Not given\".",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Path to this file's JSON Schema."
    },
    "Health_Insti": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "bgImageURL": {
            "type": "string",
            "description": "Background image: a path in this API like /images/<Folder>/<file>.webp, or a full https:// URL.",
            "format": "uri-reference"
          },
          "source": {
            "type": "string",
            "description": "Main page of the institution.",
            "format": "uri"
          },
          "description": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "lastVerified": {
            "$ref": "#/$defs/lastVerified"
          },
          "contacts": {
            "$ref": "#/$defs/contacts",
            "description": "Main contacts of the whole institution, e.g. a national hotline. Branch contacts are inside each branch."
          },
          "branches": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/branch"
            },
            "minItems": 1
          },
          "services": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "serviceID": {
                  "type": "integer"
                },
                "branchIDs": {
                  "type": "array",
                  "items": {
                    "type": "integer"
                  },
                  "minItems": 1,
                  "uniqueItems": true,
                  "description": "Branches that offer this service. Each must be a branchID of the same institution."
                },
                "service_name": {
                  "type": "string"
                },
                "service_description": {
                  "type": "string"
                },
                "cancerTypes": {
                  "$ref": "#/$defs/cancerTypes"
                },
                "fee": {
                  "type": [
                    "null",
                    "string"
                  ],
                  "description": "Fee as written by the source, e.g. '₱5,000 per session' or 'Free'. null if not given."
                },
                "sources": {
                  "$ref": "#/$defs/sources"
                },
                "service_schedule": {
                  "type": [
                    "array",
                    "null"
                  ],
                  "items": {
                    "$ref": "#/$defs/scheduleEntry"
                  },
                  "description": "Days and hours of this service. Empty list = follows the branch hours. null if not given."
                },
                "requirements": {
                  "$ref": "#/$defs/requirements"
                },
                "procedure": {
                  "$ref": "#/$defs/procedure"
                }
              },
              "required": [
                "serviceID",
                "branchIDs",
                "service_name",
                "service_description",
                "cancerTypes",
                "fee",
                "sources",
                "service_schedule",
                "requirements",
                "procedure"
              ],
              "additionalProperties": false
            }
          },
          "coverage": {
            "type": "array",
            "description": "Payment and financial-help programs this hospital accepts or is accredited for. Empty if not given (show \"Not given\").",
            "items": {
              "type": "object",
              "properties": {
                "programID": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "description": "The program in FinancialInstiData (programs[].programID), so apps can link to it. null when that program is not in this API."
                },
                "name": {
                  "type": "string",
                  "description": "Program or agency name, as written by the source."
                },
                "details": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "What the source says about it at this hospital, e.g. packages, tests or office. null if not given."
                },
                "sources": {
                  "$ref": "#/$defs/sources"
                }
              },
              "required": [
                "programID",
                "name",
                "details",
                "sources"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "name",
          "bgImageURL",
          "source",
          "description",
          "type",
          "lastVerified",
          "contacts",
          "branches",
          "services",
          "coverage"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "Health_Insti"
  ],
  "additionalProperties": false,
  "$defs": {
    "contact": {
      "type": "object",
      "properties": {
        "contact_id": {
          "type": "integer"
        },
        "type": {
          "type": "string",
          "enum": [
            "Hotline",
            "Landline",
            "Mobile",
            "Email",
            "Website",
            "Facebook",
            "Other"
          ],
          "description": "Kind of contact. One fixed list for all datasets."
        },
        "contact_details": {
          "type": "string"
        }
      },
      "required": [
        "contact_id",
        "type",
        "contact_details"
      ],
      "additionalProperties": false
    },
    "contacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/contact"
      }
    },
    "scheduleEntry": {
      "type": "object",
      "properties": {
        "day": {
          "type": "string",
          "description": "Day or days as written by the source, e.g. 'Monday' or 'Monday-Friday'. A day can appear twice for split hours."
        },
        "timeIn": {
          "type": "string",
          "description": "Opening or start time, e.g. '8:00 am'."
        },
        "timeOut": {
          "type": "string",
          "description": "Closing or end time, e.g. '5:00 pm'."
        }
      },
      "required": [
        "day",
        "timeIn",
        "timeOut"
      ],
      "additionalProperties": false
    },
    "schedule": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scheduleEntry"
      },
      "description": "Open days and hours. Closed days are left out."
    },
    "branch": {
      "type": "object",
      "properties": {
        "branchID": {
          "type": "integer"
        },
        "branchName": {
          "type": [
            "null",
            "string"
          ],
          "description": "Name of the branch, e.g. 'Davao City Branch'. null if not given."
        },
        "location": {
          "type": "string"
        },
        "landmark": {
          "type": [
            "null",
            "string"
          ],
          "description": "A landmark that helps people find it, as written by the source, e.g. 'infront SPMC Hospital'. null if not given."
        },
        "latitude": {
          "type": [
            "null",
            "number"
          ],
          "description": "Latitude in decimal degrees (WGS 84), from an official source or an on-site GPS reading. null if not known."
        },
        "longitude": {
          "type": [
            "null",
            "number"
          ],
          "description": "Longitude in decimal degrees (WGS 84), from an official source or an on-site GPS reading. null if not known."
        },
        "schedule": {
          "anyOf": [
            {
              "$ref": "#/$defs/schedule"
            },
            {
              "type": "null"
            }
          ],
          "description": "Open days and hours. null if not known (show \"Not given\")."
        },
        "contacts": {
          "$ref": "#/$defs/contacts"
        }
      },
      "required": [
        "branchID",
        "branchName",
        "location",
        "landmark",
        "latitude",
        "longitude",
        "schedule",
        "contacts"
      ],
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      },
      "uniqueItems": true,
      "description": "Links to the pages these facts come from. Empty if no source is given (show \"Not given\")."
    },
    "cancerTypes": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true,
      "description": "Cancers this covers, e.g. ['Breast Cancer']. ['All cancers'] if it covers every cancer. null if the source doesn't say (show \"Not given\")."
    },
    "lastVerified": {
      "type": [
        "null",
        "string"
      ],
      "format": "date",
      "description": "Date the record was last checked against its sources, YYYY-MM-DD. null if not known."
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "requirement_id": {
            "type": "integer"
          },
          "requirement_description": {
            "type": "string"
          }
        },
        "required": [
          "requirement_id",
          "requirement_description"
        ],
        "additionalProperties": false
      }
    },
    "procedure": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "step": {
            "type": "integer"
          },
          "instruction": {
            "type": "string"
          }
        },
        "required": [
          "step",
          "instruction"
        ],
        "additionalProperties": false
      }
    }
  }
}
